<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:layoutDirection="rtl">

    <!-- ═══ الترويسة ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp"
        android:background="@color/bgdark">

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/d_avatar"
            android:gravity="center"
            android:text="R"
            android:textColor="@color/gold"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ Rabie MAC Scanner"
                android:textColor="@color/gold"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="فاحص اشتراكات STALKER — بواباتك وماكاتك"
                android:textColor="@color/textDim"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══ المحتوى: 3 شاشات ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="64dp"
        android:orientation="vertical">

        <!-- ─── الشاشة 1: الرئيسية ─── -->
        <ScrollView
            android:id="@+id/screenHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="30dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/d_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="🌐 البوابة (اكتبها كما هي — بـ/c أو بدونها)"
                        android:textColor="@color/textSub"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etPortal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/d_field"
                        android:hint="apksmart.dino.ws:80/c"
                        android:importantForAutofill="no"
                        android:inputType="textUri"
                        android:padding="11dp"
                        android:singleLine="true"
                        android:textColor="@color/textMain"
                        android:textColorHint="#4A556E"
                        android:textDirection="ltr"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvEndpointHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/green"
                        android:textSize="11sp"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/d_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="📄 ملف الـMACs"
                        android:textColor="@color/textSub"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnPickMacs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/d_dashed"
                        android:text="📂 اختيار ملف macs.txt"
                        android:textAllCaps="false"
                        android:textColor="@color/gold"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnPasteToggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/d_dashed"
                        android:text="📝 أو لصق الماكات يدوياً (سطر لكل ماك)"
                        android:textAllCaps="false"
                        android:textColor="@color/textSub"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etPaste"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/d_field"
                        android:gravity="top"
                        android:hint="00:1A:79:XX:XX:XX&#10;00:1A:79:YY:YY:YY"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:minLines="3"
                        android:padding="10dp"
                        android:textColor="@color/textMain"
                        android:textColorHint="#4A556E"
                        android:textDirection="ltr"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvMacsInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="ما اخترت ملف بعد"
                        android:textColor="@color/textDim"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/d_card"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:text="🧵 الخيوط"
                            android:textColor="@color/textSub"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/etThreads"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/d_field"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:padding="9dp"
                            android:singleLine="true"
                            android:text="50"
                            android:textColor="@color/textMain"
                            android:textDirection="ltr"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:text="🔒 بروكسي (سطر لكل واحد)"
                            android:textColor="@color/textSub"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/etProxy"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/d_field"
                            android:hint="بدون — أو عدة بروكسيات سطر لكل واحد"
                            android:importantForAutofill="no"
                            android:inputType="textMultiLine|textUri"
                            android:padding="9dp"
                            android:minLines="1"
                            android:textColor="@color/textMain"
                            android:textColorHint="#4A556E"
                            android:textDirection="ltr"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/d_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <CheckBox
                        android:id="@+id/cbGeo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/gold"
                        android:text="🌍 تجاوز GEO — ترويسات Mini"
                        android:textColor="@color/textSub"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="6dp"
                                android:text="📅 فلتر: استبعد أقل من (يوم)"
                                android:textColor="@color/textSub"
                                android:textSize="12sp" />

                            <EditText
                                android:id="@+id/etMinDays"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/d_field"
                                android:importantForAutofill="no"
                                android:inputType="number"
                                android:padding="9dp"
                                android:singleLine="true"
                                android:text="0"
                                android:textColor="@color/textMain"
                                android:textDirection="ltr"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="6dp"
                                android:text="🎲 عدد ماكات التوليد"
                                android:textColor="@color/textSub"
                                android:textSize="12sp" />

                            <EditText
                                android:id="@+id/etGenCount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/d_field"
                                android:hint="20"
                                android:importantForAutofill="no"
                                android:inputType="number"
                                android:padding="9dp"
                                android:singleLine="true"
                                android:textColor="@color/textMain"
                                android:textColorHint="#4A556E"
                                android:textDirection="ltr"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnGenMacs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/d_dark_btn"
                            android:text="🎲 ولّد"
                            android:textAllCaps="false"
                            android:textColor="@color/gold"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btnStart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/d_gold"
                    android:padding="15dp"
                    android:text="⚡ ابدأ الفحص"
                    android:textAllCaps="false"
                    android:textColor="#06080F"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLastRun"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="النتائج تُحفظ في Hits/go_hits.txt"
                    android:textColor="@color/textDim"
                    android:textSize="11sp" />
            </LinearLayout>
        </ScrollView>

        <!-- ─── الشاشة 2: أثناء التشغيل ─── -->
        <ScrollView
            android:id="@+id/screenRunning"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="30dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/d_card"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/tvRunPortal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:gravity="center"
                        android:text="⏳ جاري الفحص…"
                        android:textColor="@color/textSub"
                        android:textSize="14sp" />

                    <ProgressBar
                        android:id="@+id/pbProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="14dp"
                        android:progressBackgroundTint="@color/field"
                        android:progressTint="@color/gold"
                        android:secondaryProgressTint="#3A4A6E" />

                    <TextView
                        android:id="@+id/tvProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="0 / 0 — 0%"
                        android:textColor="@color/gold"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/d_card"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvCHits"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/green"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎯 Hits"
                            android:textColor="@color/textDim"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/d_card"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvCBlocked"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/red"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⛔ مقفول"
                            android:textColor="@color/textDim"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/d_card"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvCNet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/gray"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🌐 شبكة"
                            android:textColor="@color/textDim"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvGhost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="👻 شبح/بلا بيانات: 0 · 🔑 فشل توثيق: 0"
                    android:textColor="@color/textDim"
                    android:textSize="11sp" />

                <ScrollView
                    android:id="@+id/svLog"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/d_field"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tvLog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text=""
                        android:textColor="@color/textMain"
                        android:textDirection="ltr"
                        android:textSize="11sp" />
                </ScrollView>

                <Button
                    android:id="@+id/btnStop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/d_red_btn"
                    android:padding="12dp"
                    android:text="⏹️ إيقاف الفحص"
                    android:textAllCaps="false"
                    android:textColor="@color/red"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="الإيقاف لا يفقد النتائج — المحفوظ يبقى"
                    android:textColor="@color/textDim"
                    android:textSize="11sp" />
            </LinearLayout>
        </ScrollView>

        <!-- ─── الشاشة 3: النتائج ─── -->
        <ScrollView
            android:id="@+id/screenResults"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="30dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/d_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="📋 التلخيص النهائي"
                        android:textColor="@color/gold"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text=""
                        android:textColor="@color/textMain"
                        android:textDirection="ltr"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/d_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="🎯 النتائج الناجحة"
                        android:textColor="@color/gold"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="260dp">

                        <LinearLayout
                            android:id="@+id/hitsList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </ScrollView>
                </LinearLayout>

                <Button
                    android:id="@+id/btnShare"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/d_gold"
                    android:padding="13dp"
                    android:text="📤 مشاركة النتائج"
                    android:textAllCaps="false"
                    android:textColor="#06080F"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnAgain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/d_dark_btn"
                    android:padding="12dp"
                    android:text="🔄 فحص جديد"
                    android:textAllCaps="false"
                    android:textColor="@color/textSub"
                    android:textSize="14sp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
